[
  {
    "name": "set_wifi",
    "description": "Turn the device Wi-Fi on or off.",
    "triggers": ["\\b(wi-?fi|internet)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "on": { "type": "boolean", "description": "true to turn on, false to turn off" }
      },
      "required": ["on"]
    }
  },
  {
    "name": "set_bluetooth",
    "description": "Turn Bluetooth on or off.",
    "triggers": ["\\b(bluetooth)\\b"],
    "parameters": {
      "type": "object",
      "properties": { "on": { "type": "boolean" } },
      "required": ["on"]
    }
  },
  {
    "name": "set_torch",
    "description": "Turn the flashlight (torch) on or off.",
    "triggers": ["\\b(lanterna|flash|tocha|flashlight|torch)\\b"],
    "parameters": {
      "type": "object",
      "properties": { "on": { "type": "boolean" } },
      "required": ["on"]
    }
  },
  {
    "name": "set_brightness",
    "description": "Set the screen brightness.",
    "triggers": ["\\b(brilho|brightness)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "brightness in percent"
        }
      },
      "required": ["level"]
    }
  },
  {
    "name": "set_volume",
    "description": "Set the volume of an audio stream.",
    "triggers": ["\\b(volume|som)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "stream": {
          "type": "string",
          "enum": ["media", "ring", "alarm", "notification", "call"]
        },
        "level": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["stream", "level"]
    }
  },
  {
    "name": "open_app",
    "description": "Open an installed app by the name the user says.",
    "triggers": ["\\b(abre|abrir|open|launch)\\b"],
    "parameters": {
      "type": "object",
      "properties": { "name": { "type": "string" } },
      "required": ["name"]
    }
  },
  {
    "name": "set_ac",
    "description": "Control the air conditioner: power, temperature and mode.",
    "triggers": ["\\b(ar[- ]condicionado|air[- ]?con(ditioner)?|clima)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "power": { "type": "boolean" },
        "temp": { "type": "integer", "minimum": 16, "maximum": 30 },
        "mode": { "type": "string", "enum": ["cool", "heat", "fan", "dry", "auto"] }
      },
      "required": ["power"]
    }
  },
  {
    "name": "notify",
    "description": "Show a notification or reminder.",
    "triggers": ["\\b(me lembra|lembrete|notifica|remind|reminder|notify)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["title", "text"]
    }
  },
  {
    "name": "send_sms",
    "description": "Send an SMS to a contact or number.",
    "triggers": ["\\b(manda|envia|send)\\b.{0,24}\\b(sms|mensagem|message|texto)\\b"],
    "parameters": {
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["to", "text"]
    }
  },
  {
    "name": "run_shell",
    "description": "Run an allowed shell command on the device.",
    "triggers": ["\\b(roda|executa|run)\\b.{0,24}\\b(comando|shell|command)\\b"],
    "parameters": {
      "type": "object",
      "properties": { "cmd": { "type": "string" } },
      "required": ["cmd"]
    }
  }
]
